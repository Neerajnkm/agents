OPENAI_API_KEY=your-openai-api-key
OPENAI_DEFAULT_MODEL=gpt-3.5-turbo

GEMINI_API_KEY=your-gemini-api-key
GEMINI_DEFAULT_MODEL=gemini-pro

LLAMA_API_URL=http://localhost:8000/api/generate
LLAMA_DEFAULT_MODEL=llama-2-7b

HUGGINGFACE_API_KEY=your-huggingface-api-key
HUGGINGFACE_DEFAULT_MODEL=bigscience/bloom

GROQ_API_KEY=your-groq-api-key
GROQ_DEFAULT_MODEL=llama-2-70b-chat

LLM_PROVIDER=your-llm-provider  # options: openai, gemini, llama, huggingface, groq

# ChromaDB configuration

CHROMADB_PERSIST_DIR=your-chromadb-persistence-directory

# Logging configuration

LOG_LEVEL=INFO         # or DEBUG, WARNING, ERROR
LOG_DEST=console       # or file
LOG_FILE=agents.log    # (only used if LOG_DEST=file)
LOG_FORMAT=%(asctime)s %(levelname)s %(name)s %(message)s